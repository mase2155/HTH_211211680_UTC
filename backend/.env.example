# ===== Ứng dụng =====
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
# true khi chạy sau reverse proxy (nginx) để rate-limit lấy đúng IP
TRUST_PROXY=false
# Danh sách origin được phép gọi API, phân tách bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173

# ===== SQL Server =====
DB_SERVER=localhost
DB_PORT=1433
# Điền tên instance nếu dùng named instance (vd: SQLEXPRESS); khi đó DB_PORT bị bỏ qua
DB_SERVER=localhost
DB_PORT=1433
DB_INSTANCE=
DB_NAME=SportBooking
DB_USER=sportbooking_app
DB_PASSWORD=HungMase@2005
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true# ===== Xác thực =====
# Chuỗi ngẫu nhiên >= 32 ký tự. Tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_random_string_of_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# ===== Nghiệp vụ đặt sân =====
APP_TIMEZONE=Asia/Ho_Chi_Minh
BOOKING_MAX_DAYS_AHEAD=30
BOOKING_HOLD_MINUTES=15
BOOKING_CANCEL_BEFORE_MINUTES=60
BOOKING_MAX_PENDING_PER_USER=3

# ===== Upload ảnh sân =====
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_MB=2

# ===== Chỉ dùng cho npm run db:seed (tạo tài khoản Admin) =====
ADMIN_EMAIL=hathehung260923@gmail.com
ADMIN_PASSWORD=Admin@123456
ADMIN_FULL_NAME=Hà Thế Hưng
ADMIN_PHONE=0818269203
