{
  "info": {
    "name": "Sport Booking API",
    "description": "REST API đặt sân — import kèm SportBooking.postman_environment.json",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Postman User\",\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\",\n  \"phone\": \"0909123456\"\n}"
            }
          }
        },
        {
          "name": "Login customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (pm.response.code === 200 && json.data?.accessToken) {",
                  "  pm.environment.set('accessToken', json.data.accessToken);",
                  "  pm.environment.set('userId', String(json.data.user.id));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (pm.response.code === 200 && json.data?.accessToken) {",
                  "  pm.environment.set('accessToken', json.data.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/refresh"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/logout",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Fields & schedule",
      "item": [
        {
          "name": "List fields",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/fields?limit=20&status=Active"
          }
        },
        {
          "name": "Get field by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/fields/{{fieldId}}"
          }
        },
        {
          "name": "Field schedule",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/fields/{{fieldId}}/schedule?date={{bookingDate}}"
          }
        },
        {
          "name": "Schedule board",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/schedule?fieldTypeId={{fieldTypeId}}&date={{bookingDate}}"
          }
        },
        {
          "name": "List field types",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/field-types"
          }
        },
        {
          "name": "List time slots",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/time-slots?fieldTypeId={{fieldTypeId}}"
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fieldId\": \"{{fieldId}}\",\n  \"timeSlotId\": \"{{timeSlotId}}\",\n  \"bookingDate\": \"{{bookingDate}}\",\n  \"customerName\": \"Postman\",\n  \"customerPhone\": \"0909123456\",\n  \"paymentMethod\": \"Online\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.environment.set('bookingId', String(pm.response.json().data.id));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "My bookings",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/bookings/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Get booking",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/bookings/{{bookingId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Simulate payment",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/bookings/{{bookingId}}/payment",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Cancel booking",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/bookings/{{bookingId}}/cancel",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Postman test\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Admin list bookings",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/bookings?limit=20",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Admin update status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/bookings/{{bookingId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Confirmed\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Stats",
      "item": [
        {
          "name": "Overview",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/stats/overview",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Revenue by day",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/stats/revenue?groupBy=day",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Field performance",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/stats/fields",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "CMS",
      "item": [
        {
          "name": "List news",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/news-posts?limit=10"
          }
        },
        {
          "name": "List partners",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/partner-items?limit=10"
          }
        }
      ]
    }
  ]
}
